# Only reviewed documentation and source code belong in this repository.
*
!/.gitignore
!/.gitattributes
!/README.md
!/docs/
!/docs/*.md
!/docs/images/
!/docs/images/*.jpg
!/src/
!/src/*.py
!/src/*.c
!/src/*.java
!/src/*.ps1
!/src/*.sh
!/src/*.cmd
!/overlay/
!/overlay/*.rc
!/overlay/*.sh
!/overlay/fstab.bfx_gsi
!/overlay/wakeup_sources-safe.txt
!/tests/
!/tests/*.py

# Reviewed connectivity sources only; build products remain ignored.
!/src/tv-connectivity/
!/src/tv-connectivity/**/
!/src/tv-connectivity/**/*.java
!/src/tv-connectivity/*.java
!/src/tv-connectivity/*.py
!/src/tv-connectivity/requirements.txt
!/src/usb-wifi/
!/src/usb-wifi/**/
!/src/usb-wifi/**/*.py
!/src/usb-wifi/**/*.c
!/src/usb-wifi/**/*.sh
!/src/usb-wifi/**/*.rc
!/src/usb-wifi/**/*.conf
!/src/usb-wifi/**/*.xml
!/src/usb-wifi/**/*.json
!/src/usb-wifi/**/Makefile
!/src/usb-wifi/*.py
!/src/usb-wifi/*.c
!/src/usb-wifi/*.sh
!/src/usb-wifi/*.json
!/src/usb-wifi/Makefile
!/src/usb-wifi/requirements.txt

!/src/tv-connectivity/LICENSE
!/src/usb-wifi/LICENSE
!/src/usb-wifi/NOTICE.md
