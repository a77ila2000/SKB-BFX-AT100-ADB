# Only reviewed documentation and source code belong in this repository.
*
!/.gitignore
!/.gitattributes
!/README.md
!/docs/
!/docs/*.md
!/docs/images/
!/docs/images/*.jpg
!/src/
!/src/*.py
!/src/*.c
!/src/*.java
!/src/*.ps1
!/src/*.sh
!/src/*.cmd
!/overlay/
!/overlay/*.rc
!/overlay/*.sh
!/overlay/fstab.bfx_gsi
!/overlay/wakeup_sources-safe.txt
!/tests/
!/tests/*.py
