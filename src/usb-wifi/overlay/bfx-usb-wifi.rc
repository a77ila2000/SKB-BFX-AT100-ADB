on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    restorecon_recursive /data/vendor/wifi

# Load only after the immutable read-only probe has collected this boot's export table.
on property:sys.bfx.wifi_abi.state=exported
    exec_background u:r:phhsu_daemon:s0 root -- /system/bin/sh /system/etc/bfx-usb-wifi-load.sh

# A HAL started before wlan0 exists caches an unusable interface inventory.
on property:sys.bfx.usb_wifi_driver=loaded
    restart vendor.wifi_hal_legacy
    setprop sys.bfx.usb_wifi_hal restarted

# This definition precedes the old vendor duplicate. No original vendor file is changed.
service vendor.wifi_hal_legacy /system/bin/hw/bfx-wifi-hal
    override
    class hal
    user wifi
    group wifi inet gps
    capabilities NET_ADMIN NET_RAW
    seclabel u:r:hal_wifi_default:s0
    interface android.hardware.wifi@1.0::IWifi default
    interface android.hardware.wifi@1.1::IWifi default
    interface android.hardware.wifi@1.2::IWifi default
    interface android.hardware.wifi@1.3::IWifi default
    interface android.hardware.wifi@1.4::IWifi default

service wpa_supplicant /system/bin/hw/bfx-wpa-supplicant -O/data/vendor/wifi/wpa/sockets -puse_p2p_group_interface=1 -g@android:wpa_wlan0
    class main
    user wifi
    group wifi inet keystore
    capabilities NET_ADMIN NET_RAW
    seclabel u:r:hal_wifi_supplicant_default:s0
    socket wpa_wlan0 dgram 660 wifi wifi
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    interface android.hardware.wifi.supplicant@1.2::ISupplicant default
    interface android.hardware.wifi.supplicant@1.3::ISupplicant default
    disabled
    oneshot
